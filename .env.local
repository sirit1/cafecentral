# ==========================================
# Environment Variables - Phase 3 Setup
# ==========================================
# Copie este archivo como .env.local y complete con sus propias claves

# Stripe
# 1. Crea cuenta en https://stripe.com
# 2. Ve a Developers > API Keys
# 3. Stripe Secret Key: sk_test_... (usa esta en backend)
# 4. Publishable Key: pk_test_... (usa esta en frontend)
STRIPE_SECRET_KEY=sk_test_51Q...
NEXT_PUBLIC_STRIPE_KEY=pk_test_51Q...

# Stripe Checkout URL (para Payment Link)
# Crea un Payment Link en Stripe y pon el URL aquí
STRIPE_CHECKOUT_URL=https://pay.stripe.com/...

# Supabase
# 1. Crea proyecto en https://supabase.com
# 2. Ve a Settings > API
# 3. Supabase URL: https://xxxxx.supabase.co
# 4. Anon Public Key: eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Google Maps API
# 1. Visita https://console.cloud.google.com/apis/credentials
# 2. Crea credenciales API Key
# 3. Añádelos abajo para habilitar Google Maps APIs
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Si ya tienes un MapId configurado para el proyecto
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Café Central